{
  "name": "news-portal-cms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@php-wasm/node": "^3.1.47",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-http-proxy": "^1.6.7",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
